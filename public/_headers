# Keep the *.workers.dev URL out of search results so it doesn't
# compete with / duplicate the real domain.
https://dominickdominick.:subdomain.workers.dev/*
	X-Robots-Tag: noindex

# The headers on every file the asset store sends. The index page, the stylesheet and every other file in this folder are answered by the asset
# store itself and never reach the Worker, so these are the headers they get: this block is the one that matters for pages. worker/security-headers.js
# carries the same list for what the Worker answers (a missing address, an error); tests/site.test.mjs fails if the two drift apart.
# Policy: no inline script or style, no eval, nothing from another site, no framing by another site. Loosen it in both places when the new site needs to.
/*
	X-Content-Type-Options: nosniff
	X-Frame-Options: SAMEORIGIN
	Referrer-Policy: strict-origin-when-cross-origin
	Strict-Transport-Security: max-age=31536000; includeSubDomains
	Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
	Content-Security-Policy: default-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'
