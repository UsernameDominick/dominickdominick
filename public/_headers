# Keep the *.workers.dev URL out of search results so it doesn't
# compete with / duplicate the real domain.
https://dominickdominick.:subdomain.workers.dev/*
	X-Robots-Tag: noindex

# Files sent straight from the asset store never pass through the Worker, so they do not get the Worker's security headers. These are the
# ones that are safe for every static file: no MIME sniffing, no framing on other sites, less referrer leakage, https only. (No page-wide
# CSP here: the Worker already sets the site's CSP on every response it sends.)
/*
	X-Content-Type-Options: nosniff
	X-Frame-Options: SAMEORIGIN
	Referrer-Policy: strict-origin-when-cross-origin
	Strict-Transport-Security: max-age=31536000; includeSubDomains
